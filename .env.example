# Copy to .env and fill in. Used by the app (SRT_*) and by docker compose.

# --- Required -------------------------------------------------------------
# JWT signing key, at least 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
SRT_JWT_SECRET_KEY=
# Postgres password for the compose stack (also used by the backup service).
SRT_DB_PASSWORD=

# --- First administrator (created at startup if it does not exist) -----------
SRT_BOOTSTRAP_ADMIN_USERNAME=
SRT_BOOTSTRAP_ADMIN_PASSWORD=

# --- Database for uvicorn / the CLI (unset = SQLite tracker.db) ---------------
# Compose database: SRT_DATABASE_URL=postgresql+psycopg://srt:<SRT_DB_PASSWORD>@127.0.0.1:5433/school_risks
# DATABASE_URL (e.g. set by Neon on Vercel) is used when SRT_DATABASE_URL is not set;
# postgres:// and postgresql:// URLs are accepted.

# --- Vercel only (optional) ----------------------------------------------------
# SRT_MIGRATE_ON_BUILD=0                 # skip `alembic upgrade head` in the build (e.g. Preview)

# --- Deployment (optional) ---------------------------------------------------
# SRT_CORS_ORIGINS=["https://risques.example.fr"]
# SRT_TRUSTED_PROXIES=["172.18.0.1"]      # reverse proxy allowed to set X-Forwarded-For
# SRT_HTTP_BIND=127.0.0.1                 # interface the API port is published on
# SRT_HTTP_PORT=8000
# WEB_CONCURRENCY=2                       # API worker processes
# BUILD_VERSION=v1.0.0                    # image tag, shown by /health
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=14
# BACKUP_UID=1000                         # owner of the files in ./backups
# BACKUP_GID=1000
